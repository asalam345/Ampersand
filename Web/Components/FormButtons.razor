@typeparam T where T : class, new()
<link rel="stylesheet" href="./css/form-button.css" />
<div Style="display:flex;justify-content:end;gap:10px;margin-top:10px;">
<ButtonRF Class="reset" type="reset" Icon="fa-solid fa-repeat">Reset</ButtonRF>
                        
 <button class="@saveButtonClass" onclick="@save">Save</button>
</div>
@code {
    [Parameter] public FormRF<T> FormObj { get; set; } = null!;
    [Parameter] public EventCallback Save { get; set; }
    [Parameter] public Func<T, Task<T?>> OnBeforeSave { get; set; }
    string saveButtonClass { get; set; } = "button-rf save";

    async Task save()
    {
        saveButtonClass = "button-rf loading";
        StateHasChanged();
        if (FormObj == null) return;
        if (FormObj?.Data != null && OnBeforeSave != null)
        {
            var modifiedData = await OnBeforeSave.Invoke(FormObj.Data);

            if (modifiedData != null)
            {
                FormObj.Data = modifiedData;
            }
            else 
            {
                saveButtonClass = "button-rf save"; 
                return;
            }
        }
        if (!FormObj!.IsValid()) 
        {
            saveButtonClass = "button-rf save"; 
            return;
        }
        
        
        await Task.Delay(3000);
        
        StateHasChanged();
        await Save.InvokeAsync();
        FormObj!.Reset();
        saveButtonClass = "button-rf save";
        //FormRF!.Data!.TransactionTypeId = new();
    }
}
