<style>
    .save {
        background: linear-gradient(45deg, #6a11cb, #2575fc);
        color: #fff;
    }

        .save:hover {
            color: #fafafa;
        }

    .reset {
        background: linear-gradient(45deg, #e67e22, #ffc107);
        color: #fff;
    }


    .save::before {
        content: "\f0c7";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        margin-right: 10px;
        font-size: 18px;
    }

    .loading::before {
        content: "\f110"; /* fa-spinner unicode */
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        margin-right: 10px;
        animation: spin 1s linear infinite;
        font-size: 18px;
        cursor:not-allowed;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>
@typeparam T where T : class, new()
<ButtonRF Class="reset" type="reset" Icon="fa-solid fa-repeat">Reset</ButtonRF>
                        
 <button class="@saveButtonClass" onclick="@save">Save</button>
@* <ButtonRF Class="@(formRF?.IsValid() == true ? saveButtonClass : "save")" OnClick="@save">Save</ButtonRF> *@
@* <ButtonRF Class="@saveButtonClass" type="submit">Save</ButtonRF> *@
                   

@code {
    [Parameter] public FormRF<T> FormObj { get; set; } = null!;
    [Parameter] public EventCallback Save { get; set; }
    [Parameter] public Func<T, Task<T?>> OnBeforeSave { get; set; }
    string saveButtonClass { get; set; } = "button-rf save";

    async Task save()
    {
        if (FormObj == null) return;
        if (FormObj?.Data != null && OnBeforeSave != null)
        {
            var modifiedData = await OnBeforeSave.Invoke(FormObj.Data);

            if (modifiedData != null)
            {
                FormObj.Data = modifiedData;
            }
            else return;
        }
        if (!FormObj!.IsValid()) return;
        saveButtonClass = "button-rf loading";
        StateHasChanged();
        await Task.Delay(3000);
        saveButtonClass = "button-rf save";
        StateHasChanged();
        await Save.InvokeAsync();
        FormObj!.Reset();
        //FormRF!.Data!.TransactionTypeId = new();
    }
}
