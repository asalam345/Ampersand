<style>
    .tg-list-item {
        display: inline-block;
    }

    .tgl {
        display: none;
    }

        .tgl + .tgl-btn {
            outline: 0;
            display: block;
            width: 8em;
            height: 2.2em;
            position: relative;
            cursor: pointer;
            user-select: none;
            overflow: hidden;
            transform: skew(-10deg);
            transition: all 0.25s ease;
            font-family: sans-serif;
            border-radius: 4px;
            background: #888;
        }

    /* TEXT COMMON */
    .tgl-skewed + .tgl-btn:before,
    .tgl-skewed + .tgl-btn:after {
        transform: skew(10deg);
        position: absolute;
        width: 100%;
        text-align: center;
        line-height: 2.2em;
        font-weight: bold;
        color: #fff;
        transition: all 0.25s ease;
    }

    /* NOT APPROVED TEXT */
    .tgl-skewed + .tgl-btn:before {
        content: attr(data-tg-off);
        left: 0;
    }

    /* APPROVED TEXT */
    .tgl-skewed + .tgl-btn:after {
        content: attr(data-tg-on);
        left: 100%;
    }

    /* ===================== */
    /* CHECKED STATE (REAL)  */
    /* ===================== */

    .tgl-skewed:checked + .tgl-btn {
        background: #86d993;
    }

        .tgl-skewed:checked + .tgl-btn:before {
            left: -100%;
        }

        .tgl-skewed:checked + .tgl-btn:after {
            left: 0;
        }

    /* ===================== */
    /* HOVER PREVIEW          */
    /* ===================== */

    /* Hover when NOT checked → show Approved preview */
    .tgl-skewed:not(:checked):hover + .tgl-btn {
        background: #86d993;
    }

        .tgl-skewed:not(:checked):hover + .tgl-btn:before {
            left: -100%;
        }

        .tgl-skewed:not(:checked):hover + .tgl-btn:after {
            left: 0;
        }

    /* Hover when CHECKED → show Not Approved preview */
    .tgl-skewed:checked:hover + .tgl-btn {
        background: #888;
    }

        .tgl-skewed:checked:hover + .tgl-btn:before {
            left: 0;
        }

        .tgl-skewed:checked:hover + .tgl-btn:after {
            left: 100%;
        }

    /* Click animation */
    .tgl-skewed + .tgl-btn:active {
        transform: skew(-10deg) scale(0.97);
    }
</style>

<div class="tg-list-item">
    <input class="tgl tgl-skewed"
           id="@Id"
           type="checkbox"
           checked="@Value"
           @onchange="OnChanged" />

    <label class="tgl-btn"
           data-tg-off="Not Approve"
           data-tg-on="Approved"
           for="@Id">
    </label>
</div>

@code {

    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();

    [Parameter] public bool Value { get; set; }

    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    [Parameter] public EventCallback<(string Id, bool Value)> OnValueChanged { get; set; }

    private async Task OnChanged(ChangeEventArgs e)
    {
        bool newValue = (bool)e.Value!;

        Value = newValue;

        await ValueChanged.InvokeAsync(newValue);

        await OnValueChanged.InvokeAsync((Id, newValue));
    }
}
