@page "/"
@namespace Web.Pages
@using Microsoft.AspNetCore.Components.Web
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
}
<style>
    .rf-page-left-menu-body ul > li > a {
        padding: 10px;
        color: #5A3E2D !important;
    }
    .rf-page-left-menu-body ul > li > a.active {
        background-color: #8d410da8;
        padding: 10px;
        color: #5A3E2D !important;
    }

    .layoutheader-rf {
        background-color: #6f4e37dd !important;
    }

    .rf-page-header-action-item {
        color: #5A3E2D !important;
    }

        .rf-page-header-action-item > .rf-page-header-action-item-userletter {
            background-color: #ffffff20 !important;
        }

    .rf-page-left-menu-body ul > li {
        padding: 5px 10px 5px 2px !important;
        white-space: nowrap;
    }   

    
    .layoutfooter-rf.layoutfooter-thin-rf{
        width:100%;
        position: fixed;
        bottom: 0;
        left: 0px;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: space-around;
        border-top: 1px solid #ffffffe0;
        background-color: transparent;
    }

   

    body:has(.layoutbody-rf > .rf-page-left-menu.True) .layoutfooter-rf.layoutfooter-thin-rf {
        width: calc(100% - 260px);
        left: 260px;
    }
</style>
<head>
    <component type="typeof(HeadOutlet)" render-mode="Server" />
</head>
<component type="typeof(App)" render-mode="Server" />


<script src="/home/js/vendor/jquery-3.5.1.min.js"></script>
<script src="/home/js/vendor/modernizr-3.7.1.min.js"></script>
<script src="/home/js/popper.min.js"></script>
<script src="/home/js/bootstrap.min.js"></script>
<script src="/home/js/slick.min.js"></script>
<script src="/home/js/jquery.easing.min.js"></script>
<script src="/home/js/scrolling-nav.js"></script>
<script src="/home/js/wow.min.js"></script>
<script src="/home/js/main.js"></script>