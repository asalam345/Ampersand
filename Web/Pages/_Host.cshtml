<script>
    // Global function to initialize map
    window.initializeLeafletMap = function (elementId, lat, lng, zoom, title, address) {
        // Check if map already exists
        if (window.leafletMap) {
            window.leafletMap.remove();
        }
        
        // Initialize the map
        var map = L.map(elementId, {
        center: [23.505, 90.09],
            zoom: 16,
            scrollWheelZoom: false,
            wheelPxPerZoomLevel: 80  
        }).setView([lat, lng], zoom);
        window.leafletMap = map; // Store reference globally

        // Add tile layer
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        // Add marker
        var marker = L.marker([lat, lng]).addTo(map);
        marker.bindPopup("<b>" + title + "</b><br>" + address).openPopup();

        return true;
    }

    // Cleanup function
    window.disposeLeafletMap = function () {
        if (window.leafletMap) {
            window.leafletMap.remove();
            window.leafletMap = null;
        }
    }
</script>
