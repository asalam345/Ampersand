@* @using RapidFireUI.Account
@attribute [LoginPageRF]

<LoginPageRF>
    <LoginLeftPanelRF>
        <div class="gg-left-section">
            <div class="gg-welcome-content">
                <h1 class="gg-welcome-title">Welcome to</h1>
                <h2 class="gg-brand-title">
                    Glide<span class="gg-brand-go">GO</span>
                </h2>

                <!-- Illustration -->
                <div class="gg-illustration">
                    <div class="illustration">           </div>
                </div>

                <div class="gg-learn-section">
                    <h3 class="gg-learn-title">Learn about GlideGo</h3>
                    <p class="gg-learn-subtitle">Click below to learn what GlideGo can do for your organization.</p>
                    <button class="gg-scroll-btn">
                        Scroll to learn more
                        <span class="gg-scroll-icon">▼</span>
                    </button>
                </div>
            </div>
        </div>
    </LoginLeftPanelRF>
   <LoginRightPanel>
        
        <div>
            <div class="gg-right-section">
                <div class="gg-login-card">

                    <div class="gg-logo-badge">
                        <span class="gg-logo-text">GG</span>
                    </div>
                    <div class="gg-card-wrapper @(isGuestMode ? "show" : "hide")">

                    </div>

                    @if (!isGuestMode)
                    {
                        <!-- DEFAULT: SSO View -->
                        <div class="gg-form-title">Welcome Back</div>
                        <p class="gg-form-subtitle">Sign in to continue</p>

                        <button class="gg-submit-btn" @onclick="() => { }">
                            Sign in with SSO
                        </button>

                        <div style="text-align:center; margin: 16px 0; color:#999;">OR</div>

                        <button class="gg-back-btn" @onclick="EnableGuestMode">
                            Continue as Guest
                        </button>

                        <p class="gg-terms-text">
                            By continuing, you agree to our
                            <a href="#" class="gg-terms-link">Terms of Service</a> and
                            <a href="#" class="gg-terms-link">Privacy Policy</a>
                        </p>
                    }
                    else
                    {
                        <!-- GUEST LOGIN FORM -->
                        <div class="gg-form-title">Continue as Guest</div>
                        <p class="gg-form-subtitle">Enter your credentials to continue</p>
                        <div class="gg-login-form">
                            <LoginFormRF  Title="" />
                            <button type="button"
                                    class="gg-back-btn"
                                    @onclick="DisableGuestMode">
                                Back
                            </button>

                            <p class="gg-terms-text">
                                By continuing, you agree to our
                                <a href="#" class="gg-terms-link">Terms of Service</a>
                                and
                                <a href="#" class="gg-terms-link">Privacy Policy</a>
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

   </LoginRightPanel>
</LoginPageRF>

@code{
    
    public class MicrosoftSSO : ISSO
    {
        public MicrosoftSSO() : base(SSOProvider.Microsoft) { }
    }
    MicrosoftSSO item { get; set; } = new();
    protected override void OnInitialized()
    {
        item = new MicrosoftSSO
        {
            Title = "Microsoft Login",
            Icon = "Microsoft.png",
            IconColor = "#db4437",
            BackgroundColor = "#ffffff"
        };
        base.OnInitialized();
    }

    bool isGuestMode = false;

    string email;
    string password;
    bool showPassword = false;

    void EnableGuestMode() => isGuestMode = true;
    void DisableGuestMode() => isGuestMode = false;

    void TogglePassword() => showPassword = !showPassword;
  
} *@