@page "/my-wallet"
<style>
    .table-rf{
        padding:0 10px;
    }

    .my-wallet-container {
        display: flex;
        gap: 10px;
        height: auto;
    }

        .my-wallet-container .my-wallet-wrapper {
        flex: 1 1 760px;
        background-color: #fff;
        padding: 5px 0 0;
        border-radius: 10px;
        background: linear-gradient(260deg, #6a11cb, #2575fc), white;
        background-clip: padding-box, border-box;
        height: 90%;
    }
    .my-wallet-form{
        padding: 10px;
        background-color: #fff;
        border-radius: 10px;
    }

        .my-wallet-form .textarea-rf{
            width:100%;
        }
</style>
<PageRF Title="My Wallets" SubTitle="">
    <PageHeaderRF>
        <Actions></Actions>
    </PageHeaderRF>
    <div class="my-wallet-container">
        <div class="my-wallet-wrapper">
            @* OnAfterSave="@RF.UI.Events.Back" *@
            <FormRF @bind-Data="model" @bind-form=formRF class="my-wallet-form">
                <RowRF>
                    <ColRF Span="6">
                        <SelectRF @bind-Value="context.TransactionTypeId"
                                  OptionList="new List<TransactionType>()"
                                  DisplayText="c => c.Name"
                                  ValueText="c => c.TransactionTypeId"
                                  Label="Transaction Type" />
                    </ColRF>
                    <ColRF Span="6">
                        <SelectRF @bind-Value="context.PaymentTypeId"
                                  OptionList="new List<PaymentType>()"
                                  DisplayText="c => c.Name"
                                  ValueText="c => c.PaymentTypeId"
                                  Label="PaymentType Type" />
                    </ColRF>
                    <ColRF Span="6">
                        <InputRF @bind-Value="@context.Amount" Label="Amount" />
                    </ColRF>
                    <ColRF Span="6">
                        <InputRF @bind-Value="@context.ReferenceNo" Label="Reference No" />
                    </ColRF>
                    <ColRF Span="12">
                        <TextareaRF @bind-Value="context.Remarks" Label="Remarks" />
                    </ColRF>
                    <ColRF Span="12">
                        <ImageUploaderRF @bind-Value="context.Image"/>
                    </ColRF>
                   
                    <ColRF Span="12">
                        <FormButtons FormObj="@formRF" OnBeforeSave="beforeSave"></FormButtons>
                    </ColRF>
                </RowRF>
            </FormRF>
        </div>
        <TableRF Model="WalletTransaction">
            <HeaderRowTemplate>
                <td>Amount</td>
                <td>Transaction Type</td>
                <td>Payment Type</td>
                <td>Created At</td>
            </HeaderRowTemplate>
            <BodyRowTemplate>
                <td>@context.Amount</td>
                <td>@context.TransactionTypeId</td>
                <td>@context.PaymentTypeId</td>
                <td>@context.CreatedAt</td>
            </BodyRowTemplate>
        </TableRF>
    </div>
</PageRF>

@code {
    WalletTransaction model { get; set; } = new();
    FormRF<WalletTransaction> formRF = null!;
    Db db = null!;

    protected override void OnInitialized()
    {
        db = new(config);
        base.OnInitialized();
    }
    // protected override Task OnAfterRenderAsync(bool firstRender)
    // {
    //     formRF.Data.PaymentTypeId = 1;
    //     formRF.Data.TransactionTypeId = 0;
    //     return base.OnAfterRenderAsync(firstRender);
    // }
    async Task<WalletTransaction?> beforeSave(WalletTransaction model)
    {
        db = new(config);
        var membershipId = db.Get<Membership>().Where(c => c.MembershipId == userInfo.User.Id).Select(x => x.MembershipId).SingleOrDefault();
        if (membershipId == null)
        {
            RF.UI.Toaster.Info("Membership not found for the user.");
            return null;
        }
        model.UserId = userInfo.User.Id;
        model.MembershipId = membershipId;
        await Task.CompletedTask; // Add any async operations if needed
        return model;
    }
    
    // void save()
    // {
    //     db.Save(formRF.Data);
    //     var result = db.Commit();
    // }
}
