@page "/my-wallet"
<PageRF Title="My Wallets" SubTitle="">
    <PageHeaderRF>
        <Actions></Actions>
    </PageHeaderRF>
    <div style="display:flex;gap:10px">
        <div style="flex:1 1 760px;">
            @* OnAfterSave="@RF.UI.Events.Back" *@
            <FormRF @ref=formRF Model="WalletTransaction" >
                <RowRF>
                    <ColRF Span="6">
                        <SelectRF @bind-Value="context.TransactionTypeId"
                                  OptionList="new List<TransactionType>()"
                                  DisplayText="c => c.Name"
                                  ValueText="c => c.TransactionTypeId"
                                  Label="Transaction Type" />
                    </ColRF>
                    <ColRF Span="6">
                        <SelectRF @bind-Value="context.PaymentTypeId"
                                  OptionList="new List<PaymentType>()"
                                  DisplayText="c => c.Name"
                                  ValueText="c => c.PaymentTypeId"
                                  Label="PaymentType Type" />
                    </ColRF>
                    <ColRF Span="6">
                        <InputRF @bind-Value="@context.Amount" Label="Amount" />
                    </ColRF>
                    <ColRF Span="6">
                        <InputRF @bind-Value="@context.ReferenceNo" Label="Reference No" />
                    </ColRF>
                    <ColRF Span="12">
                        <ImageUploaderRF @bind-Value="context.Image"/>
                    </ColRF>
                    <ColRF Span="12">
                        <TextareaRF @bind-Value="context.Remarks"/>
                    </ColRF>
                    <ColRF Span="12" Style="display:flex;justify-content:end;gap:10px;">
                        <FormButtons FormObj="@formRF" Save="@save" OnBeforeSave="beforeSave"></FormButtons>
                        @* <ButtonRF type="submit" Icon="fa-solid fa-floppy-disk" Style="background-color:">Save</ButtonRF>
                        <ButtonRF type="reset" Icon="fa-solid fa-arrows-rotate">Reset</ButtonRF> *@
                    </ColRF>
                </RowRF>
            </FormRF>
        </div>
        <TableRF Model="WalletTransaction">
            <HeaderRowTemplate>
                <td>Amount</td>
                <td>Transaction Type</td>
                <td>Payment Type</td>
                <td>Created At</td>
            </HeaderRowTemplate>
            <BodyRowTemplate>
                <td>@context.Amount</td>
                <td>@context.TransactionTypeId</td>
                <td>@context.PaymentTypeId</td>
                <td>@context.CreatedAt</td>
            </BodyRowTemplate>
        </TableRF>
    </div>
</PageRF>

@code {
    FormRF<WalletTransaction> formRF = null!;
    Db db = null!;

    protected override void OnInitialized()
    {
        db = new(config);
        base.OnInitialized();
    }
    async Task<WalletTransaction?> beforeSave(WalletTransaction model)
    {
        db = new(config);
        var membershipId = db.Get<Membership>().Where(c => c.AspNetUsersId == userInfo.User.Id).Select(x => x.MembershipId).SingleOrDefault();
        if (membershipId == null)
        {
            RF.UI.Toaster.Info("Membership not found for the user.");
            return null;
        }
        model.UserId = userInfo.User.Id;
        model.MembershipId = membershipId;
        await Task.CompletedTask; // Add any async operations if needed
        return model;
    }
    
    void save()
    {
        db.Save(formRF.Data);
        var result = db.Commit();
    }
}
