        /*   background-size: 200% auto; */
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        animation: moveFlag 60s linear infinite;
        -webkit-text-stroke: 1px #427621;
    }

    @@keyframes moveFlag {
        0%

    {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }

    }
</style>

