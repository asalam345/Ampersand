    ElementReference mapContainer;
    // Coordinates for Ampersand
    private double lat = 23.791524449999997;
    private double lng = 90.41139575;
    private int zoom = 16;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initHomeTemplate");
            await InitializeMap();
        }
    }
    


    private async Task InitializeMap()
    {
        // Call the global JavaScript function directly
        await JS.InvokeVoidAsync(
            "initializeLeafletMap",
            "myMap",           // element ID
            lat,               // latitude
            lng,               // longitude
            zoom,              // zoom level
            "Ampersand",       // title
            "TecHHub, Save the Children, Dhaka, Bangladesh"  // address
        );
    }

    private async Task ZoomIn()
    {
        zoom++;
        await ReinitializeMap();
    }

    private async Task ZoomOut()
    {
        zoom--;
        await ReinitializeMap();
    }

    private async Task ReinitializeMap()
    {
        await JS.InvokeVoidAsync(
            "initializeLeafletMap",
            "myMap",
            lat,
            lng,
            zoom,
            "Ampersand",
            "TecHHub, Save the Children, Dhaka, Bangladesh"
        );
    }

    public async ValueTask DisposeAsync()
    {
        // Clean up the map
        await JS.InvokeVoidAsync("disposeLeafletMap");
    }
}
