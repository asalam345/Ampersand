@* @using RapidFireUI.Account

@attribute [LoginPageRF]
<style>
    .login-page {
        width: 100%;
        height: 100vh;
        display: inline-block;
        display: flex;
        align-items: center;
        background-image: url("/image/loginBG.png");
        background-size: cover;
        background-repeat: no-repeat;
        color: #222221;
    }

    .rf-login-form .validation-message {
        line-height: 0;
        margin-top: 2px;
    }

    .rf-login-form-title {
        display: none;
    }

    .btnLogin {
        background: #DA291C;
        border: 1px solid #DA291C;
        color: #FFFFFF;
        margin: 2px;
        padding: 8px 35px;
        min-width: 100%;
    }

        .btnLogin:hover {
            color: #DA291C;
            border: 1px solid #DA291C;
            background: #FFFFFF;
        }


    .input-group-text {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-right: none;
    }

        

    .red-starics {
        color: #DA291C;
    }

    .form-control {
        padding: 8px;
        text-align: left;
        border-left: none;
    }

    .invalid,
    [invalid] {
        border:1px solid;
        border-color: var(--control-invalid-border-color) !important;
    }
</style>
<LoginPageRF>
    <div class="login-page">
        <div class="container">
            <div class="row">
                <div class="col-md-10 offset-md-1">
                    <div class="m-5">
                        <div class="row">
                            <div class="col-md-5 ps-0 d-none d-md-block">
                                <div class="form-left h-100 d-flex align-items-center justify-content-center text-center">
                                    <div class="row">
                                        <div class="col-12">
                                            <img src="/image/prmsLogo.png" />
                                        </div>
                                      
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2"></div>
                            <div class="col-md-5 bg-white rounded shadow">
                                <div class="form-right h-100 py-5 px-4">
                                    <LoginFormRF Context="c">
                                        <div class="row pb-4 d-none d-md-block">
                                            <div class="col-12 d-flex justify-content-center">
                                                <img src="/image/scilogo.svg" height="40" />
                                            </div>
                                        </div>
                                        <div class="row pb-4 d-block d-sm-none">
                                            <div class="col-12 d-flex justify-content-around">
                                                <img src="/image/scilogo.svg" height="30" />
                                                <img src="/image/prmsLogo.png" height="30" />
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 p-2">
												
                                                <label>Email Address <span class="red-starics">*</span></label>
                                                <div class="input-group mb-2 mt-1">
                                                    <span class="input-group-text" id="Email"><i class="far fa-envelope tw-text-lg"></i></span>
                                                    <InputText type="text" @bind-Value="@c.Email" class="form-control" placeholder="example@savethechildren.org" aria-describedby="Email" />
                                                </div>
                                                <ValidationMessage For="@(() => c.Email)" />
                                            </div>
                                            <div class="col-12 p-2">
												
                                                <label>Password <span class="red-starics">*</span></label>
                                                <div class="input-group mb-2 mt-1">
                                                    <span class="input-group-text" id="Password"><i class="fas fa-lock tw-text-lg"></i></span>
                                                    <InputText type="password" @bind-Value="@c.Password" class="form-control" placeholder="************" aria-describedby="Password" />
                                                </div>
                                                <ValidationMessage For="@(() => c.Password)" />
                                            </div>
                                            <div class="col-12 p-2">
                                                <ButtonRF type="submit" Class="btnLogin">Login</ButtonRF>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end">
                                                <a href="/Account/ResetPassword">Forgot Password?</a>
                                            </div>
                                        </div>
                                    </LoginFormRF>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</LoginPageRF>
@code {
    string AppSlogan;
    protected override Task OnInitializedAsync()
    {
        var appInfo = new RapidFire(config).Config.Item.APP;
        AppSlogan = appInfo.AppSlogan;
        return base.OnInitializedAsync();
    }
} *@
