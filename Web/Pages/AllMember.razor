@page "/members"
@using static Web.Components.MemberCheckbox
<style>
    img {
        max-width: 40px;
        height: auto;
        display: block;
    }

    .table-rf.membership-table {
        height: calc(100vh - 170px);
    }
    /* Style ENTIRE ROW based on child td class */
    .membership-table tr:has(td.row-indicator-ok) {
        background-color: #d4edda60 !important;
        color: #155724 !important;
        /* Add other row styles here */
    }

    .membership-table tr:has(td.row-indicator-red) {
        background-color: #f8d7da60 !important;
        color: #721c24 !important;
        /* Add other row styles here */
    }

        /* Optional: Ensure action column inherits row style */
        .membership-table tr:has(td.row-indicator-ok) td.table-rf-action,
        .membership-table tr:has(td.row-indicator-red) td.table-rf-action {
            background-color: inherit !important;
        }
</style>
<PageRF Title="Ampersand" SubTitle="All Members">
    <PageHeaderRF></PageHeaderRF>
    <TableRF Model="MembershipView" PageSize="10" Class="membership-table">
        <HeaderRowTemplate>
            <th>Membership ID</th>
            <th>Full Name & Info</th>
            <th>Current Address</th>
            <th>Permanent Address</th>
            <th>Unit Purchase Information</th>
            <th>Treasurer</th>
            <th>Secretary</th>
            <th>President</th>
        </HeaderRowTemplate>
        <BodyRowTemplate>
            <td class="@(!string.IsNullOrEmpty(context.MembershipId) ? "row-indicator-ok" : "row-indicator-red")">
                <img src="@context.Photo" alt="@context.MembershipId" />ID: @context.MembershipId
            </td>
            <td>@context.FullName <br /> <i class="fa-solid fa-envelope"></i> @context.Email<br /><i class="fa-solid fa-phone"></i> @context.PhoneNumber<br /> <i class="fa-solid fa-mars-and-venus"></i> @context.Gender</td>
            <td>@context.CurrentAddress</td>
            <td>@context.PermanentAddress</td>
            <td>@context.MembershipStartingDate</td>
            <td>
                @* Label="@spinnerValue.DisplayText" *@
                @context.Treasurer <br /> @context.TreasurerReceivedDate
                @if (userInfo.Role.Name == "Treasurer")
                {
                    <MemberCheckbox Id="@context.Id"
                                    Value="@context.IsTreasurerApproved"
                                    OnValueChanged="@(data => saveToDb(data, context, userInfo.Role.Name))" />
                }
            </td>
            <td>
                @context.Secretary <br /> @context.SecretaryReceivedDate
                @if (userInfo.Role.Name == "Secretary" && !string.IsNullOrEmpty(context.TreasurerId) && context.TreasurerReceivedDate != null)
                {
                    <MemberCheckbox Id="@context.Id"
                                    Value="@context.IsSecretaryApproved"
                                    OnValueChanged="@(data => saveToDb(data, context, userInfo.Role.Name))" />

                }
            </td>
            <td>
                @context.President <br /> @context.PresidentReceivedDate
                @if (userInfo.Role.Name == "President" && !string.IsNullOrEmpty(context.SecretaryId) && context.SecretaryReceivedDate != null)
                {
                    <MemberCheckbox Id="@context.Id"
                                    Value="@context.IsPresidentApproved"
                                    OnValueChanged="@(data => saveToDb(data, context, userInfo.Role.Name))" />
                }
            </td>
            @* </div> *@
        </BodyRowTemplate>
    </TableRF>
</PageRF>
@code {
    List<SpinnerValue> verification { get; set; } = new();
    SpinnerValue spinnerValue { get; set; } = new();
    string signature1 { get; set; }
    Dictionary<string, bool> signatureDict = new();
    Membership membership { get; set; }
    protected override void OnInitialized()
    {
        spinnerValue = new SpinnerValue { DisplayText = "I allow this member", ValueText = userInfo.User.Id };
        verification = new()
        {
            new SpinnerValue{DisplayText = "I allow this member", ValueText = userInfo.User.Id},
        };
        base.OnInitialized();
    }
    void tsChanged(object o)
    {
        if (membership != null)
            membership.TreasurerId = o?.ToString();
    }

    void psChanged(object o)
    {
        if (membership != null)
            membership.PresidentId = o?.ToString();
    }
    async Task saveToDb((string id, bool value) data, MembershipView context, string colName)
    {
        var db = new Db(config);
        var member = db.Get<Membership>()
                       .FirstOrDefault(x => x.AspNetUsersId == data.id);

        if (!string.IsNullOrEmpty(member?.MembershipId))
        {
            // ⭐ UPDATE CONTEXT FIRST (IMPORTANT)
            switch (colName)
            {
                case "Treasurer":
                    context.TreasurerId = data.value ? userInfo.User.Id : null;
                    break;

                case "Secretary":
                    context.SecretaryId = data.value ? userInfo.User.Id : null;
                    break;

                case "President":
                    context.PresidentId = data.value ? userInfo.User.Id : null;
                    break;
            }

            // DB entity update
            switch (colName)
            {
                case "Treasurer":
                    member.TreasurerId = context.TreasurerId;
                    member.TreasurerReceivedDate = data.value ? DateTime.UtcNow : null;
                    break;

                case "Secretary":
                    member.SecretaryId = context.SecretaryId;
                    member.SecretaryReceivedDate = data.value ? DateTime.UtcNow : null;
                    break;

                case "President":
                    member.PresidentId = context.PresidentId;
                    member.PresidentReceivedDate = data.value ? DateTime.UtcNow : null;
                    member.MemberVarified = data.value;
                    if (data.value)
                    {
                        var aspNetUserRole = db.Get<AspNetUserRoles>().First(x => x.UserId == data.id);
                        aspNetUserRole.RoleId = "6b49feb2-7488-4356-90ac-a345e9feb730";
                        db.Save(aspNetUserRole);
                    }
                    break;
            }

            db.Save(member);
            var result = db.Commit();

            if (result.Success)
            {
                RF.UI.Toaster.Success();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

