@page "/signup"
@using System.Text.RegularExpressions
@using Domain.Contexts
@using Microsoft.AspNetCore.Identity
@* @using Microsoft.Data.SqlClient *@
@using RapidFireLib.Lib.Core
@using RapidFireLib.Models.Identity
@using RapidFireLib.View.Models.Identity
@using RapidFireLib.View.UserInfo
@using RapidFireUI.Account
@using Domain.Services
@using System.Security
@using Microsoft.Data.SqlClient
@using System.Data

@attribute [AllowAnonymous]
@attribute [UserSetupPageRF]
@layout PublicLayout
<link href="./css/reglogin.css" rel="stylesheet" />
<div class="auth-container">
    <div class="auth-image"></div>
    <div class="auth-forms">
        <h2>Create Account</h2>
        <FormRF Model="AspNetUsers" @ref="formRF" OnBeforeSave="beforeSave" OnAfterSave="afterSave">
            <div class="form-group">
                <InputRF class="form-control" Label="Full Name" @bind-Value="context.FullName" placeholder="Enter Your Full Name" />
            </div>
            <div class="form-group">
                <InputRF class="form-control" Label="Email"  @bind-Value="context.Email" placeholder="you@example.com" />
            </div>
            <div class="form-group" style="position:absolute;left:-100%;height:0;">
                <InputRF class="form-control" Label="User Name"  @bind-Value="context.UserName" placeholder="you@example.com" />
            </div>
            <div class="form-group">
                <InputRF class="form-control" Label="Phone Number"  @bind-Value="context.PhoneNumber" placeholder="01********" />
            </div>
            <div class="form-group">
                <InputRF type="password" Label="Password" class="form-control" @bind-Value="password" placeholder="••••••••" />
            </div>
            <div class="form-group">
                <InputRF type="password" Label="Confirm Password" class="form-control" @bind-Value="confirmPassword" placeholder="••••••••" />
            </div>
           @*  <div class="form-group">
                <DatePickerRF Label="Date of Birth" class="form-control" @bind-Value="dob" placeholder="Your date of birth" />
            </div> *@
            <button type="submit" class="btn">Sign Up</button>
        </FormRF>
        <div class="switch-form">
            Already have an account? <a href="/account/login?returnUrl=/home">Sign In</a>
        </div>
    </div>
</div>
@* <ExtendedUserRF Model="ExtendedUserInfo">
    <RowRF>
        <ColRF>
            <InputRF @bind-Value="context.Model.StaffId" Label="Staff Id" Placeholder="Staff Id" StartIcon="fa-solid fa-user" EndIcon="fa-solid fa-users" />
        </ColRF>
    </RowRF>
</ExtendedUserRF> *@

@code {
    Db? db { get; set; } = null!;
    FormRF<AspNetUsers>? formRF { get; set; }
    string? confirmPassword = "12345";
    string? password = "12345";
    DateTime dob { get; set; } = DateTime.Now.AddYears(-18);

    protected override void OnInitialized()
    {

    }
    protected override void OnAfterRender(bool firstRender)
    {
        formRF.Data.FullName = "A";
        formRF.Data.PhoneNumber = "016736055241";
        base.OnAfterRender(firstRender);
    }
    bool alreadyExist(string value, string item)
    {
        db = new Db(config);
        switch (item)
        {
            case "email":
                return db.Get<AspNetUsers>(x => x.Email == value).Any();
            case "phone":
                return db.Get<AspNetUsers>(x => x.PhoneNumber == value).Any();
        }

        return false;
    }
    AspNetUsers beforeSave(AspNetUsers r)
    {
        if (string.IsNullOrWhiteSpace(password) || password.Length < 5 || password != confirmPassword)
        {
            if (password?.Length < 5)
                RF.UI.Toaster.Warning("Password Length must be at lest 5");
            else if (password != confirmPassword)
                RF.UI.Toaster.Warning("Password and confirm pasword not match");
            return new AspNetUsers();
        }
        if (alreadyExist(r.Email, "email"))
        {
            RF.UI.Toaster.Warning("Email already exists!");
            return new AspNetUsers();
        }
        if (alreadyExist(r.PhoneNumber, "phone"))
        {
            RF.UI.Toaster.Warning("Phone number already exists!");
            return new AspNetUsers();
        }
        r.CreateDate = DateTime.Now;
        r.UserName = r.Email;
        r.NormalizedUserName = r.UserName.ToUpperInvariant();
        r.NormalizedEmail = r.Email.ToUpperInvariant();
        r.IsActive = true;

        var options = new PasswordHasherOptions
        {
            CompatibilityMode = PasswordHasherCompatibilityMode.IdentityV2
        };

        var hasher = new PasswordHasher<AspNetUsers>(
            Microsoft.Extensions.Options.Options.Create(options)
        );

        r.PasswordHash = hasher.HashPassword(r, password!);

        return r;
    }


    void afterSave(AspNetUsers r)
    {
        db = new Db(config);
        ApplicationUserRole ar = new();
        ar.RoleId = "6b49feb2-7488-4356-90ac-a345e9feb730"; //this is the role id of basic user
        ar.UserId = r.Id;
        ar.AppUserId = r.UserId;
        db.Save(ar);
        var result = db.Commit();

     }
}