@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Identity
@using RapidFireLib.View.Models.Identity
@using RapidFireLib.View.UserInfo
@using RapidFireUI.Account
@using Domain.Services
@attribute [LoginPageRF]
@layout PublicLayout

<link href="./css/reglogin.css" rel="stylesheet" />
<link rel="stylesheet" href="./css/form-button.css" />
<style>
    .form-control > input {
        padding: 0 !important;
    }
</style>

<div class="auth-container">
    <div class="auth-image"></div>
    <div class="auth-forms">
        <h2>Welcome to Ampersand</h2>
        <LoginFormRF Title="">
            <ChildContent Context="loginModel">
                @{
            loginModel.Email = email;
            loginModel.Password = password;
                <InputRF @bind-Value="@loginModel.Email" Label="Email" Placeholder="Enter your email" />
                <InputRF Type="password" @bind-Value="@loginModel.Password" Label="Password" Placeholder="Enter your password" />
                <div style="display:flex;justify-content:space-between;">
                    <a href="/Account/ResetPassword">Forget Password?</a>
                        <ButtonRF Icon="fa-solid fa-key" Class="log-button" type="submit">Sign In</ButtonRF>
                </div>
                }
            </ChildContent>
           
        </LoginFormRF>
        <div class="switch-form">
            Don’t have an account? <a href="/signup">Sign Up</a>
        </div>
    </div>
</div>



@code {
    public class MicrosoftSSO : ISSO
    {
        public MicrosoftSSO() : base(SSOProvider.Microsoft) { }
    }
    MicrosoftSSO item { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(userInfo.User?.Id))
        {
            var returnUrl = GetReturnUrl();

            if (!string.IsNullOrEmpty(returnUrl))
            {
                nav.NavigateTo(returnUrl, true);
            }
            else
            {
                nav.NavigateTo("/my-wallet", true);
            }
        }


        item = new MicrosoftSSO
        {
            Title = "Microsoft Login",
            Icon = "Microsoft.png",
            IconColor = "#db4437",
            BackgroundColor = "#ffffff"
        };
        await base.OnInitializedAsync();
    }

    bool isGuestMode = false;

    string email = "a0167360@gmail.com";
    string password = "12345";
    bool showPassword = false;

    void EnableGuestMode() => isGuestMode = true;
    void DisableGuestMode() => isGuestMode = false;

    void TogglePassword() => showPassword = !showPassword;
    private string GetReturnUrl()
    {
        var uri = nav.ToAbsoluteUri(nav.Uri);

        // Parse query string manually
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return query["returnUrl"];

        // OR using Microsoft.AspNetCore.WebUtilities if available:
        // var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        // if (query.TryGetValue("returnUrl", out var returnUrlValues))
        // {
        //     return returnUrlValues.First();
        // }
        // return null;
    }

}