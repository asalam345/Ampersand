@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Identity
@using RapidFireLib.View.Models.Identity
@using RapidFireLib.View.UserInfo
@using RapidFireUI.Account
@using Domain.Services
@attribute [LoginPageRF]
@layout PublicLayout

<link href="./css/reglogin.css" rel="stylesheet" />
<link rel="stylesheet" href="./css/form-button.css" />
<style>
    .form-control > input {
        padding: 0 !important;
    }
</style>

<div class="auth-container">
    <div class="auth-image"></div>
    <div class="auth-forms">
        <h2>Welcome to Ampersand</h2>
        <LoginFormRF Title="" @ref=formRF>
            <InputRF @bind-Value="context.Email"
                     @bind-Value:after="() => email = context.Email" Label="Email / User Name / Phone Number" Placeholder="Enter your email or user name or phone number" />

            <InputRF Type="password"
                     @bind-Value="context.Password"
                     @bind-Value:after="() => password = context.Password" Label="Password" Placeholder="Enter your password" />
            <div style="display:flex;justify-content:space-between;">
                <a href="/Account/ResetPassword">Forget Password?</a>
                <ButtonRF Icon="fa-solid fa-key" Class="log-button" OnClick="login">Sign In</ButtonRF>
                <button type="submit"  id="rf-login-btn" style="width:0;height:0;position:absolute;left:-100%;">Sign In</button>
            </div>
        </LoginFormRF>
        <div class="switch-form">
            Don’t have an account? <a href="/signup">Sign Up</a>
        </div>
    </div>
</div>



@code {
    Db db = null!;
    LoginFormRF? formRF { get; set; } = null!;
    FormRF<LoginModel>? _form;
    bool isGuestMode = false;

    string email = "";
    string password = "12345";
    bool showPassword = false;
    string userName { get; set; } = string.Empty;


    public class MicrosoftSSO : ISSO
    {
        public MicrosoftSSO() : base(SSOProvider.Microsoft) { }
    }
    MicrosoftSSO item { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(userInfo.User?.Id))
        {
            var returnUrl = GetReturnUrl();

            if (!string.IsNullOrEmpty(returnUrl))
            {
                nav.NavigateTo(returnUrl, true);
            }
            else
            {
                nav.NavigateTo("/my-wallet", true);
            }
        }


        item = new MicrosoftSSO
        {
            Title = "Microsoft Login",
            Icon = "Microsoft.png",
            IconColor = "#db4437",
            BackgroundColor = "#ffffff"
        };
        await base.OnInitializedAsync();
    }



    void EnableGuestMode() => isGuestMode = true;
    void DisableGuestMode() => isGuestMode = false;

    void TogglePassword() => showPassword = !showPassword;
    private string GetReturnUrl()
    {
        var uri = nav.ToAbsoluteUri(nav.Uri);

        // Parse query string manually
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return query["returnUrl"];

        // OR using Microsoft.AspNetCore.WebUtilities if available:
        // var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        // if (query.TryGetValue("returnUrl", out var returnUrlValues))
        // {
        //     return returnUrlValues.First();
        // }
        // return null;
    }
    async Task login()
    {
        db = new(config);
        var userFromDb = db.Get<AspNetUsers>(x => x.Email == email || x.UserName == email || x.PhoneNumber == email).FirstOrDefault();
        var options = new PasswordHasherOptions
        {
            CompatibilityMode = PasswordHasherCompatibilityMode.IdentityV2
        };

        var hasher = new PasswordHasher<AspNetUsers>(
            Microsoft.Extensions.Options.Options.Create(options)
        );
        
        
        if (userFromDb == null)
        {
            RF.UI.Toaster.Warning("No user found!");
            return;
        }
        if(userFromDb.PasswordHash == null)
        {
            RF.UI.Toaster.Warning("No user found!");
            return;
        }
        
        var result = hasher.VerifyHashedPassword(
            userFromDb,
            userFromDb!.PasswordHash!,
            password
        );

        if (result == PasswordVerificationResult.Success ||
            result == PasswordVerificationResult.SuccessRehashNeeded)
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementsByName('Email')[0].value='{userFromDb.UserName}';document.getElementsByName('Password')[0].value='{password}';document.getElementById('rf-login-form').submit()");
        }
        else
        {
            RF.UI.Toaster.Warning("Password not match!");
        }
    }

}